# ============================================================
# openeo-workspace-service – environment configuration
# Copy this file to .env and edit as needed.
# ============================================================

# ----------------------------------------------------------
# Server
# ----------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Comma-separated list of allowed CORS origins (* = all)
CORS_ORIGINS=*

# ----------------------------------------------------------
# Elasticsearch
# ----------------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9200

# Leave blank to connect without authentication (local dev)
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Path to CA certificate bundle for TLS verification
# ELASTICSEARCH_CA_CERTS=/path/to/ca.crt
ELASTICSEARCH_VERIFY_CERTS=true

# Prefix for index names (useful for sharing a cluster between envs)
ELASTICSEARCH_INDEX_PREFIX=openeo_workspaces

# ----------------------------------------------------------
# Keycloak / OIDC
# ----------------------------------------------------------
# Base URL of your Keycloak server
KEYCLOAK_URL=http://localhost:8080

# Realm name
KEYCLOAK_REALM=openeo

# Client ID registered in Keycloak
KEYCLOAK_CLIENT_ID=workspace-service

# Client secret (leave blank for public clients)
KEYCLOAK_CLIENT_SECRET=

# JWT signing algorithms accepted (comma-separated for multi)
JWT_ALGORITHMS=RS256

# JWT audience claim (defaults to KEYCLOAK_CLIENT_ID if not set)
# JWT_AUDIENCE=workspace-service

# ----------------------------------------------------------
# Workspace providers
# ----------------------------------------------------------
# Name of the provider used when intent=create and no type is specified.
# Must match a provider name defined in Elasticsearch (seeded on startup).
# DEFAULT_WORKSPACE_PROVIDER=S3

# ----------------------------------------------------------
# Internal provisioning API
# ----------------------------------------------------------
# Shared secret for the PUT /internal/workspaces/{id}/status endpoint.
# Leave blank (or unset) to disable the endpoint entirely.
# INTERNAL_API_KEY=change-me-to-a-strong-random-secret

# ----------------------------------------------------------
# Logging
# ----------------------------------------------------------
# Force JSON log output regardless of DEBUG mode.
# Defaults to JSON when DEBUG=false, pretty console when DEBUG=true.
# JSON_LOGS=true

# ----------------------------------------------------------
# Rate limiting (in-process, per authenticated user)
# ----------------------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_S=60
