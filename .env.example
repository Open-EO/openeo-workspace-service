# API Configuration
DEBUG=false
API_VERSION=v1

# KeyCloak Configuration
KEYCLOAK_SERVER_URL=https://keycloak.example.com
KEYCLOAK_REALM=openeo
KEYCLOAK_CLIENT_ID=openeo-workspaces
KEYCLOAK_CLIENT_SECRET=your-client-secret-here
JWT_ALGORITHM=RS256

# Elasticsearch Configuration
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=your-password-here
ELASTICSEARCH_SCHEME=https
ELASTICSEARCH_INDEX_PREFIX=openeo-workspaces

# Workspace Configuration
DEFAULT_WORKSPACE_PROVIDER=s3
MAX_WORKSPACE_QUOTA=1099511627776
SUPPORTED_PROVIDERS=s3,gcs,azure

